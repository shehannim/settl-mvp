SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEMO_RETURN_OTP=false
OAUTH_STATE_SECRET=
OAUTH_STATE_EXPIRE_MINUTES=15

SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_REDIRECT_URI=http://127.0.0.1:8000/api/connect/paypal/callback
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Payoneer partner OAuth (register at developer.payoneer.com).
# Leave blank until credentials are issued — /api/connect/payoneer then
# returns 503 and the UI falls back to statement upload.
PAYONEER_CLIENT_ID=
PAYONEER_CLIENT_SECRET=
PAYONEER_REDIRECT_URI=http://127.0.0.1:8000/api/connect/payoneer/callback
PAYONEER_BASE_URL=https://api.sandbox.payoneer.com
PAYONEER_AUTH_URL=https://login.sandbox.payoneer.com/api/v2/oauth2/authorize

EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
FRONTEND_URL=http://localhost:5173