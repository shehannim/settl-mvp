SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google sign-in: OAuth client (Web app) from Google Cloud Console.
# Authorized JS origins must include the frontend (Vercel URL + http://localhost:5173).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEMO_RETURN_OTP=false
OAUTH_STATE_SECRET=
OAUTH_STATE_EXPIRE_MINUTES=15

SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_REDIRECT_URI=http://127.0.0.1:8000/api/connect/paypal/callback
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Payoneer partner OAuth (register at developer.payoneer.com).
# Leave blank until credentials are issued — /api/connect/payoneer then
# returns 503 and the UI falls back to statement upload.
PAYONEER_CLIENT_ID=
PAYONEER_CLIENT_SECRET=
PAYONEER_REDIRECT_URI=http://127.0.0.1:8000/api/connect/payoneer/callback
PAYONEER_BASE_URL=https://api.sandbox.payoneer.com
PAYONEER_AUTH_URL=https://login.sandbox.payoneer.com/api/v2/oauth2/authorize
# Confirm these against the portal API reference; override if different.
PAYONEER_TOKEN_PATH=/api/v2/oauth2/token
PAYONEER_ACCOUNT_PATH=/api/v2/account/details
PAYONEER_TX_PATH=/api/v2/account/transactions
PAYONEER_SCOPES=openid profile email account:balances:read account:transactions:read

# LinkedIn Verified (identityMe). Self-serve tiers: name/email/photo only;
# most-recent education needs Plus scope r_most_recent_education.
# Development tier = app admins only (demo-ready, not production).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/api/connect/linkedin/callback
LINKEDIN_AUTH_URL=https://www.linkedin.com/oauth/v2/authorization
LINKEDIN_SCOPES=openid profile email

EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
# Comma-separated allowlist. MUST include the production site URL
# (e.g. FRONTEND_URL=https://settl.vercel.app,http://localhost:5173)
# or OAuth callbacks bounce users to the wrong domain.
FRONTEND_URL=http://localhost:5173

# Email OTP delivery (Resend HTTPS API). Sender must be a verified domain.
# Unset = OTP endpoints answer 503 instead of pretending to send mail.
RESEND_API_KEY=
RESEND_FROM=Settl <no-reply@yourdomain.lk>